<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<!-- ✅ FINAL RESPONSIVE CSS -->
<style>

/* ✅ DESKTOP IMAGE CONTROL */
.show-img {
    height: 400px;
    object-fit: cover;
    border-radius: 15px;
}

/* Card width control (important) */
.show-card {
    max-width: 600px;
    margin: auto;
}

/* 📱 MOBILE FIX */
@media (max-width: 576px) {

    h3 {
        font-size: 1.3rem;
        text-align: center;
    }

    .show-card {
        width: 100%;
        margin: 0;
    }

    .show-img {
        height: auto;
        max-height: 250px;
    }

    .card-text {
        font-size: 0.9rem;
    }

    .d-flex {
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
        margin: 0 10px;
    }

    .edit-btn,
    form button {
        width: 100% !important;
    }

    .review-section {
        width: 100%;
        margin: 0 !important;
        padding: 0 10px;
    }

    .review-card {
        width: 100% !important;
        margin-left: 0 !important;
    }

    #map {
        height: 250px;
        width: 100%;
    }
}
</style>

<div class="row mt-3">

    <!-- TITLE -->
    <div class="col-12 col-md-8 offset-md-2">
        <h3><%= listing.title %></h3>
    </div>

    <!-- CARD -->
    <div class="card col-12 col-md-6 offset-md-3 show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img">

        <div class="card-body">

            <!-- OWNER SAFE -->
            <p class="card-text">
                Owned by:
                <i>
                    <% if (listing.owner && listing.owner.username) { %>
                        <%= listing.owner.username %>
                    <% } else { %>
                        Unknown
                    <% } %>
                </i>
            </p>

            <p class="card-text"><%= listing.description %></p>

            <p class="card-text">
                &#8377;
                <%= listing.price ? listing.price.toLocaleString("en-IN") : 'Price not available' %>
                / night
            </p>

            <p class="card-text"><%= listing.location %></p>
            <p class="card-text"><%= listing.country %></p>

        </div>
    </div>

    <br>

    <!-- EDIT DELETE -->
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex gap-2 flex-wrap mt-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
    <% } %>

    <!-- REVIEWS -->
    <div class="col-12 col-md-8 offset-md-2 mb-3 review-section">

        <% if(currUser) { %>
            <hr>
            <h4>Leave a Review</h4>

            <form action="/listings/<%= listing.id %>/reviews" method="POST" class="needs-validation">

                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <input type="number" name="review[rating]" min="1" max="5" class="form-control">
                </div>

                <div class="mb-3 mt-3">
                    <label class="form-label">Comment</label>
                    <textarea name="review[comment]" class="form-control" required></textarea>
                </div>

                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
            <p><b>All Reviews</b></p>

            <div class="row">
                <% for (let review of listing.reviews) { %>
                    <div class="card col-12 col-md-5 ms-md-3 mb-3 review-card">
                        <div class="card-body">
                            <h5>@<%= review.author.username %></h5>
                            <p><%= review.comment %></p>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>

    </div>

    <!-- MAP -->
    <div class="col-12 col-md-8 offset-md-2 mb-3">
        <h3>Where you'll be</h3>
        <div id="map" style="width: 100%; height: 300px; border-radius: 10px;"></div>
    </div>

</div>

<script src="/js/map.js"></script>