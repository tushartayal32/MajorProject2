<% layout("/layouts/boilerplate") %>

<section class="auth-page">
    <div class="auth-panel">
        <h1 class="auth-title">Login</h1>

        <form action="/login" method="POST" class="needs-validation auth-form" novalidate>
            <div>
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control" autocomplete="username" required autofocus>
            </div>

            <div>
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
            </div>

            <button class="btn auth-submit">Login</button>

            <p class="auth-switch">
                New here?
                <a href="/signup">Create an account</a>
            </p>
        </form>
    </div>
</section>
